{
  "name": "cirus-origin",
  "version": "1.0.0",
  "private": true,
  "description": "CIRUS Origin: kalkulačka podílu komponent mimo EU (pravidlo 35 %, SAFE a EDIP) a prezentační web",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node tools/build.mjs",
    "test": "node --test \"tools/test/*.test.mjs\"",
    "e2e": "node tools/e2e.mjs",
    "serve": "node tools/build.mjs --serve 8080",
    "templates": "python3 tools/make-templates.py"
  }
}
